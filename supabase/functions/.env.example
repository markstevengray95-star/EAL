# Copy this file to supabase/functions/.env for local development only.
# The copied file is ignored by Git. Deployed functions receive SUPABASE_URL,
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY automatically.

# Restrict every function to the school and the deployed app.
AUTH_ALLOWED_EMAIL_DOMAIN=adcoteschool.co.uk
APP_ALLOWED_ORIGINS=https://markstevengray95-star.github.io,http://localhost:3000,http://127.0.0.1:3000
BOOTSTRAP_ADMIN_EMAIL=mgray@adcoteschool.co.uk
BOOTSTRAP_SCHOOL_NAME=Adcote School for Girls

# Google Drive server credentials. The real values stay in Supabase secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Optional OneDrive fallback.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_BASE_PATH=EAL

# Direct iSAMS connection. The school/iSAMS administrator supplies these.
ISAMS_STUDENTS_URL=
ISAMS_API_KEY=
ISAMS_AUTH_MODE=query
ISAMS_API_KEY_PARAM=apiKey
ISAMS_API_KEY_HEADER=X-API-Key
ISAMS_HTTP_METHOD=GET
ISAMS_RECORD_PATH=
ISAMS_SCHOOL_ID=
MIS_SCHEDULE_SECRET=

# Optional provider-neutral MIS adapter instead of direct iSAMS.
MIS_SYNC_URL=
MIS_API_TOKEN=
