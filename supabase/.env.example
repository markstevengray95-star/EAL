# Supabase automatically supplies these three values to deployed Edge Functions.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SUPABASE_SECRETS_ONLY

# Restrict every function to the school and the deployed app.
AUTH_ALLOWED_EMAIL_DOMAIN=adcoteschool.co.uk
APP_ALLOWED_ORIGINS=https://markstevengray95-star.github.io,http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=mgray@adcoteschool.co.uk
BOOTSTRAP_SCHOOL_NAME=Adcote School for Girls

# Google Drive server credentials. Store real values with `supabase secrets set`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Direct iSAMS connection. The school/iSAMS administrator supplies the exact endpoint.
ISAMS_STUDENTS_URL=
ISAMS_API_KEY=
ISAMS_AUTH_MODE=query
ISAMS_API_KEY_PARAM=apiKey
ISAMS_API_KEY_HEADER=X-API-Key
ISAMS_HTTP_METHOD=GET
ISAMS_RECORD_PATH=
ISAMS_SCHOOL_ID=
MIS_SCHEDULE_SECRET=

